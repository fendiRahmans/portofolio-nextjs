DATABASE_URL=mysql://root:password@localhost:3306/nama_database

# Pusher Configuration (dapatkan dari pusher.com)
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=ap1

# Public (untuk client-side)
NEXT_PUBLIC_PUSHER_KEY=your_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Google Gemini Configuration (Optional - untuk model gratis)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# Chat Configuration
CHAT_SESSION_EXPIRY_DAYS=7